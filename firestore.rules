rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'maraapna2@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRepairRequest(data) {
      return data.keys().hasAll(['userId', 'customerName', 'customerPhone', 'bikeModel', 'serviceType', 'issueDescription', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'customerName', 'customerPhone', 'bikeModel', 'serviceType', 'issueDescription', 'status', 'preferredDate', 'adminNotes', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 25
        && data.bikeModel is string && data.bikeModel.size() > 0 && data.bikeModel.size() <= 80
        && data.serviceType is string && data.serviceType.size() > 0 && data.serviceType.size() <= 80
        && data.issueDescription is string && data.issueDescription.size() > 0 && data.issueDescription.size() <= 1000
        && data.status in ['pending', 'in_progress', 'completed', 'cancelled']
        && (!('preferredDate' in data) || (data.preferredDate is string && data.preferredDate.size() <= 50))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'phone', 'message', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'phone', 'serviceCategory', 'message', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 25
        && (!('serviceCategory' in data) || (data.serviceCategory is string && data.serviceCategory.size() <= 80))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Repair Requests
    match /repairRequests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() 
        && isValidId(requestId) 
        && isValidRepairRequest(incoming())
        && incoming().status == 'pending';

      allow update: if isSignedIn() && isValidId(requestId) && (
        // Customer updating their own contact or notes while pending
        (resource.data.userId == request.auth.uid 
          && incoming().userId == resource.data.userId
          && incoming().status == resource.data.status
          && incoming().diff(existing()).affectedKeys().hasOnly(['customerPhone', 'issueDescription', 'preferredDate', 'updatedAt']))
        ||
        // Admin updating status and diagnostic notes
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']))
      );

      allow delete: if isAdmin();
    }

    // Inquiries
    match /inquiries/{inquiryId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow update, delete: if isAdmin();
    }

    // Admins collection for role checking
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
